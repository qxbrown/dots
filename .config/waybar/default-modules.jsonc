{
     "custom/arch": {
          "format": "󰣇",
          "tooltip": false,
     },
     "custom/clock_custom": {
          "exec": "~/.config/waybar/scripts/clock_toggle.sh",
          "return-type": "plain",
          "interval": 1,
          "format": "{icon} {text}",
          "on-click": "~/.config/waybar/scripts/clock_toggle.sh toggle",
          "signal": 8,
          "tooltip": false,
     },

     "hyprland/workspaces": {
          "disable-scroll": true,
          "all-outputs": true,
          "format": "{icon}",
          "format-icons": {
               "1": "",
               "2": "",
               "3": "",
               "4": "",
               "5": "",
               "urgent": "",
               "focused": "",
               "default": "",
               "active": "󰮯",
          },
          "tooltip": false,
     },
     // --- Media ---
     "mpris": {
          "format": "{player_icon}  {title}",
          "format-paused": "{status_icon}  {title}",
          "player-icons": {
               "default": "",
               "spotify": "",
               "firefox": "",
          },
          "status-icons": {
               "paused": "",
          },
          "max-length": 30,
          "tooltip": false,
     },

     // --- Audio Group ---
     "group/audio": {
          "orientation": "horizontal",
          "modules": ["pulseaudio", "pulseaudio#mic"],
     },

     "pulseaudio": {
          "format": "{icon}  {volume}%",
          "format-muted": "󰖁",
          "format-icons": {
               "headphone": "",
               "default": ["", "", ""],
          },
          "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
          "on-right-click": "pavucontrol",
          "on-scroll-up": "bash -c 'v=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP \"\\d+%\" | head -1 | tr -d \"%\"); [ $v -lt 100 ] && pactl set-sink-volume @DEFAULT_SINK@ +5%'",
          "on-scroll-down": "bash -c 'v=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP \"\\d+%\" | head -1 | tr -d \"%\"); [ $v -gt 0 ] && pactl set-sink-volume @DEFAULT_SINK@ -5%'",
          "tooltip": false,
     },

     "pulseaudio#mic": {
          "source": true,
          "format": "{format_source}",
          "format-source": "",
          "format-source-muted": "",
          "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
          "on-right-click": "pavucontrol",
          "on-scroll-up": "bash -c 'v=$(pactl get-source-volume @DEFAULT_SOURCE@ | grep -oP \"\\d+%\" | head -1 | tr -d \"%\"); [ $v -lt 100 ] && pactl set-source-volume @DEFAULT_SOURCE@ +5%'",
          "on-scroll-down": "bash -c 'v=$(pactl get-source-volume @DEFAULT_SOURCE@ | grep -oP \"\\d+%\" | head -1 | tr -d \"%\"); [ $v -gt 0 ] && pactl set-source-volume @DEFAULT_SOURCE@ -5%'",
          "tooltip": false,
     },

     // --- System Group (Common) ---
     "tray": {
          "icon-size": 16,
          "spacing": 10,
          "tooltip": false,
     },
     "temperature": {
          "critical-threshold": 80,
          "format": "{icon} {temperatureC}°C",
          "format-icons": ["", "", ""],
          "tooltip": false,
     },
     "network": {
          "format-wifi": "  {essid}",
          "format-ethernet": "",
          "format-disconnected": "⚠",
          "on-click": "nm-connection-editor",
          "tooltip": false,
     },
     "bluetooth": {
          "format": " {status}",
          "format-connected": " {device_alias}",
          "on-click": "blueman-manager",
          "tooltip": false,
     },

     // --- Laptop Specifics ---
     "group/light": {
          "orientation": "inherit",
          "modules": ["backlight"],
     },
     "backlight": {
          "format": "{icon} {percent}%",
          "format-icons": ["", "", "", "", "", "", "", "", ""],
          "tooltip": false,
     },
     "battery": {
          "states": { "warning": 30, "critical": 15 },
          "format": "{icon} {capacity}%",
          "format-charging": " {capacity}%",
          "format-icons": ["", "", "", "", ""],
          "tooltip": false,
     },
}
